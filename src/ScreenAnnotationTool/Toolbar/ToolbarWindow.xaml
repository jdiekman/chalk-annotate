<Window x:Class="ScreenAnnotationTool.Toolbar.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Icon="/chalk.ico"
        Title="Chalk">
    <Border x:Name="Root" Background="#EE2B2B2B" CornerRadius="10" Padding="8">
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Width" Value="34"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Margin" Value="2,0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#3C3C3C"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="16"/>
                </Style>
            </StackPanel.Resources>

            <Button x:Name="BtnToggleDraw" ToolTip="Start/stop drawing (Ctrl+Alt+D)" Margin="0,0,6,0">
                <Ellipse x:Name="DrawIndicator" Width="14" Height="14" Fill="Gray"/>
            </Button>

            <Button x:Name="BtnFreehand" Content="✎" ToolTip="Freehand"/>
            <Button x:Name="BtnArrow" Content="↗" ToolTip="Arrow"/>
            <Button x:Name="BtnRect" Content="▭" ToolTip="Rectangle"/>
            <Button x:Name="BtnEllipse" Content="◯" ToolTip="Circle"/>
            <Button x:Name="BtnText" Content="T" ToolTip="Text"/>

            <Border Width="1" Background="#555" Margin="6,4"/>

            <Button x:Name="BtnColor" Background="Red" ToolTip="Color — click for shades"/>
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=BtnColor}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#F02B2B2B" CornerRadius="6" Padding="6"
                        BorderBrush="#666" BorderThickness="1">
                    <UniformGrid x:Name="SwatchGrid" Columns="5"/>
                </Border>
            </Popup>

            <Border Width="1" Background="#555" Margin="6,4"/>

            <Button x:Name="BtnThin" Content="•" ToolTip="Thin"/>
            <Button x:Name="BtnMedium" Content="●" ToolTip="Medium"/>
            <Button x:Name="BtnThick" Content="⬤" ToolTip="Thick"/>

            <Border Width="1" Background="#555" Margin="6,4"/>

            <Button x:Name="BtnUndo" Content="⤺" ToolTip="Undo (Ctrl+Z)"/>
            <Button x:Name="BtnClear" Content="🗑" ToolTip="Clear all (Ctrl+Alt+X)"/>

            <Border Width="1" Background="#555" Margin="6,4"/>

            <CheckBox x:Name="ChkStartup" Content="Startup" Foreground="White"
                      VerticalAlignment="Center" Margin="4,0"/>
            <Button x:Name="BtnClose" Content="✕" ToolTip="Hide to tray (Ctrl+Alt+D to return; Exit from the tray icon)" Background="#772222"/>
        </StackPanel>
    </Border>
</Window>
